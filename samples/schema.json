{
  "fields": [
    {
      "name": "id",
      "type": "integer",
      "required": true,
      "unique": true
    },
    {
      "name": "name",
      "target_name": "full_name",
      "type": "string",
      "required": true,
      "min_length": 2,
      "max_length": 50,
      "transform": ["trim", "uppercase"]
    },
    {
      "name": "email",
      "type": "string",
      "required": true,
      "pattern": "^[^@]+@[^@]+\\.[^@]+$",
      "transform": ["trim", "lowercase"]
    },
    {
      "name": "age",
      "type": "integer",
      "min": 16,
      "max": 100
    },
    {
      "name": "birth_date",
      "target_name": "dob",
      "type": "date",
      "format": "YYYY-MM-DD"
    }
  ]
}
